# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Database files
*.db
*.sqlite3

# Uploads (runtime files, not seed data)
uploads/

# Pytest cache
.pytest_cache/
.cache/

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
pip_out.txt

# Secrets
.env
.env.*
secrets.json

# Alembic: track env.py, alembic.ini, and version files

# Seed data — keep CSVs and JSONs, exclude large image binaries from git
# (images can be regenerated with: python -m seed.images)
seed/data/images/*.png

# Model weights — too large for git; add to Git LFS or download separately
models/*.pt
models/*.pth
models/*.onnx
models/*.bin

# Jupyter notebook checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Alembic generated versions — track them
!alembic/versions/*.py
